# Environment configuration for SDA Sabbath School Registry
# Copy this file to .env.local and update with your own keys

# Google Gemini API Key for AI features / summaries
VITE_GEMINI_API_KEY=

# Nodemailer credentials for sending registration / recovery emails (Optional)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: Override backend URL if connecting to a remote instance
# VITE_BACKEND_URL=http://localhost:3001/api
